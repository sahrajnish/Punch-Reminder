<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: an open clock-cycle arc completed by a check mark.
  The cycle stays inside the 66dp safe zone and reads clearly at launcher sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock cycle, open at the upper-right where the check completes it. -->
    <path
        android:pathData="M80.5,54 A26.5,26.5 0 1 1 65.2,30"
        android:fillColor="#00000000"
        android:strokeColor="#8AB4F8"
        android:strokeAlpha="0.85"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Check mark. -->
    <path
        android:pathData="M41,55 L49.5,63.5 L68,43"
        android:fillColor="#00000000"
        android:strokeColor="#F3F6FA"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
