<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Core permissions.
      VIBRATE: vibration for reminders.
      POST_NOTIFICATIONS: runtime notification permission (Android 13+).
      RECEIVE_BOOT_COMPLETED: rebuild schedules after a device restart.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Exact-alarm scheduling.
      - SCHEDULE_EXACT_ALARM: special app access on Android 12-13 (API 31-33).
      - USE_EXACT_ALARM: normal permission on Android 14+ (API 34+).
      Both are declared so the app can request exact scheduling across versions.
      The app checks AlarmManager.canScheduleExactAlarms() before scheduling and
      degrades gracefully when the permission is not granted.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="33" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      Package visibility (Android 11 / API 30+).
      Without these declarations the app cannot see whether greytHR is installed, so the
      "Open greytHR" button would never find the app. The market:// entry lets us resolve the
      Play Store app when the greytHR listing needs to be shown.
    -->
    <queries>
        <package android:name="com.greytip.ghress" />
        <package android:name="com.greyythr.employee" />
        <package android:name="com.greyythr" />
        <package android:name="com.greyythr.ess" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name="com.punchreminder.app.PunchReminderApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PunchReminder"
        android:windowSoftInputMode="adjustResize">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PunchReminder"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Broadcast receiver that handles reminder alarms and notification actions.
          exported="false": only this app (and the system) can send these intents.
        -->
        <receiver
            android:name=".service.ReminderReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.punchreminder.app.action.SIGN_IN_REMINDER" />
                <action android:name="com.punchreminder.app.action.SIGN_OUT_REMINDER" />
                <action android:name="com.punchreminder.app.action.CONFIRM_SIGN_IN" />
                <action android:name="com.punchreminder.app.action.CONFIRM_SIGN_OUT" />
                <action android:name="com.punchreminder.app.action.SNOOZE_SIGN_IN" />
                <action android:name="com.punchreminder.app.action.SNOOZE_SIGN_OUT" />
                <action android:name="com.punchreminder.app.action.OPEN_GREYTHR" />
            </intent-filter>
        </receiver>

        <!--
          System-event receiver: rebuilds pending reminders after a reboot,
          time change, or time-zone change so no active session is lost.
        -->
        <receiver
            android:name=".service.BootRecoveryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Daily safety net: rebuilds the day's schedule shortly after midnight and re-arms itself,
          so reminders survive days with no active reminder chain.
        -->
        <receiver
            android:name=".service.DailyRefreshReceiver"
            android:exported="false" />

    </application>

</manifest>
